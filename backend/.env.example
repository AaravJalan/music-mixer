# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Frontend URL (OAuth redirects + share links)
FRONTEND_URL=http://127.0.0.1:5173

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local API
PORT=3001
NODE_ENV=development

# DynamoDB Listening Habits table (local npm run dev without sst link)
# LISTENING_HABITS_TABLE=music-mixer-<stage>-ListeningHabitsTable-<id>
