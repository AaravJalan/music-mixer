{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/kill-dev-ports.mjs",
    "dev": "tsx watch src/local.ts",
    "build": "tsc",
    "build:lambda": "tsc && echo 'Lambda handler: dist/lambda.handler'",
    "start": "node dist/index.js",
    "generate:ghosts": "tsx scripts/generateGhosts.ts",
    "unlock": "curl -s -X POST \"$UPSTASH_REDIS_REST_URL/del/status:api_lock\" -H \"Authorization: Bearer $UPSTASH_REDIS_REST_TOKEN\" && echo ''"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1084.0",
    "@aws-sdk/lib-dynamodb": "^3.1084.0",
    "@music-mixer/shared": "*",
    "@upstash/redis": "^1.34.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "serverless-http": "^3.2.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/serverless": "^3.12.28",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
