# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Route through Vite proxy (5173) so session cookies work in Edge + all browsers
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Frontend URL (used for OAuth redirects and share links)
# Use 127.0.0.1 — Spotify blocks "localhost" in redirect URIs
FRONTEND_URL=http://127.0.0.1:5173

# Backend port
PORT=3001
NODE_ENV=development
